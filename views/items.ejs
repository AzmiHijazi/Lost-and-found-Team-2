<%- include('partials/header', { title, currentPage: 'items' }) %>

<main id="main-content" class="container py-5">
  <section class="text-center mb-5" aria-labelledby="items-heading">
    <h1 id="items-heading" class="display-6 fw-bold">Lost &amp; Found Items</h1>
    <p class="lead text-secondary mb-0">Browse recently reported lost and found items on campus.</p>
  </section>

  <% if (items.length === 0) { %>
    <p class="alert alert-info">There are no reported items yet.</p>
  <% } else { %>
    <section class="row g-4" aria-label="Reported items">
      <% for (const item of items) { %>
        <% const categoryName = item.category ? item.category.name : 'Uncategorized'; %>
        <% const ownerName = item.owner ? item.owner.name : 'Unknown'; %>
        <% const itemDate = item.date ? new Date(item.date).toLocaleDateString() : ''; %>
        <article class="col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm border-0">
            <div class="card-body d-flex flex-column">
              <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <span class="badge text-bg-<%= item.status === 'Lost' ? 'danger' : 'success' %>"><%= item.status %></span>
                <span class="small text-secondary"><%= categoryName %></span>
              </div>

              <h2 class="h5 card-title"><%= item.itemName %></h2>
              <p class="card-text text-secondary"><%= item.description %></p>

              <dl class="row small mb-4">
                <dt class="col-4">Location</dt>
                <dd class="col-8"><%= item.location %></dd>
                <dt class="col-4">Reported</dt>
                <dd class="col-8"><%= itemDate %></dd>
                <dt class="col-4">Owner</dt>
                <dd class="col-8"><%= ownerName %></dd>
              </dl>

              <a class="btn btn-outline-primary mt-auto align-self-start" href="/items/<%= item._id %>">View details</a>
            </div>
          </div>
        </article>
      <% } %>
    </section>
  <% } %>
</main>

<%- include('partials/footer', { year }) %>
