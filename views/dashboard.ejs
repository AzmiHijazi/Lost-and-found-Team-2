<%- include('partials/header', { title, currentPage }) %>

<main id="main-content" class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-7">

      <h1 class="fw-bold mb-1">Welcome back, <%= user.name %></h1>
      <p class="text-secondary">This page is only visible after you log in.</p>

      <div class="card border-0 shadow-sm mt-4">
        <div class="card-header bg-white fw-semibold">Your account</div>
        <ul class="list-group list-group-flush">
          <li class="list-group-item d-flex justify-content-between">
            <span class="text-secondary">Name</span>
            <span><%= user.name %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between">
            <span class="text-secondary">Email</span>
            <span><%= user.email %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between">
            <span class="text-secondary">Role</span>
            <span class="badge text-bg-primary"><%= user.role %></span>
          </li>
        </ul>
      </div>

      <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
        <a href="/items" class="btn btn-primary">Browse items</a>
        <a href="/contact" class="btn btn-outline-primary">Report an item</a>
        <a href="/logout" class="btn btn-outline-danger ms-sm-auto">Log out</a>
      </div>

    </div>
  </div>
</main>

<%- include('partials/footer') %>
