<%- include('partials/header', { title: title, currentPage: currentPage }) %>

<main id="main-content" class="flex-grow-1">
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-1">My Submissions</h1>
                <p class="text-secondary mb-0">Items that you have reported.</p>
            </div>

            <a href="/report-item" class="btn btn-primary">Report Item</a>
        </div>

        <% if (message) { %>
            <div class="alert alert-success"><%= message %></div>
        <% } %>

        <% if (submissions.length === 0) { %>
            <div class="alert alert-info">
                You have not submitted any items yet.
            </div>
        <% } else { %>
            <div class="row g-4">
                <% submissions.forEach((item) => { %>
                    <% const categoryName = item.category ? item.category.name : 'Uncategorized'; %>
                    <% const itemDate = item.date ? new Date(item.date).toLocaleDateString() : ''; %>
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <span class="badge <%= item.status === 'Lost' ? 'text-bg-danger' : 'text-bg-success' %> mb-2">
                                    <%= item.status %>
                                </span>

                                <h2 class="h5"><%= item.itemName %></h2>
                                <p class="text-secondary"><%= item.description %></p>
                                <p class="mb-1"><strong>Category:</strong> <%= categoryName %></p>
                                <p class="mb-1"><strong>Location:</strong> <%= item.location %></p>
                                <p class="mb-3"><strong>Date:</strong> <%= itemDate %></p>
                                <a class="btn btn-sm btn-outline-primary" href="/items/<%= item._id %>">View</a>
                                <a class="btn btn-sm btn-outline-secondary" href="/items/<%= item._id %>/edit">Edit</a>
                                <a class="btn btn-sm btn-outline-danger" href="/items/<%= item._id %>/delete">Delete</a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>
