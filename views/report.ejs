<%- include('partials/header', { title, currentPage }) %>

<main id="main-content" class="container py-5">

  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <h1 class="fw-bold mb-0">Report &amp; Summary</h1>
    <a href="/admin" class="btn btn-outline-primary">Back to admin panel</a>
  </div>

  <div class="row g-3">
    <div class="col-6 col-lg-3">
      <div class="card border-0 shadow-sm text-center h-100">
        <div class="card-body">
          <p class="display-6 fw-bold mb-0"><%= userCount %></p>
          <p class="text-secondary mb-0">Users</p>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card border-0 shadow-sm text-center h-100">
        <div class="card-body">
          <p class="display-6 fw-bold mb-0"><%= itemCount %></p>
          <p class="text-secondary mb-0">Items</p>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card border-0 shadow-sm text-center h-100">
        <div class="card-body">
          <p class="display-6 fw-bold mb-0"><%= categoryCount %></p>
          <p class="text-secondary mb-0">Categories</p>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card border-0 shadow-sm text-center h-100">
        <div class="card-body">
          <p class="display-6 fw-bold mb-0"><%= messageCount %></p>
          <p class="text-secondary mb-0">Messages</p>
        </div>
      </div>
    </div>
  </div>

  <h2 class="h5 fw-bold mt-5">Items by status</h2>
  <% if (itemsByStatus.length === 0) { %>
    <p class="alert alert-info">There are no items yet.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table align-middle bg-white">
        <thead><tr><th>Status</th><th class="text-end">Total</th></tr></thead>
        <tbody>
          <% for (const row of itemsByStatus) { %>
            <tr>
              <td><span class="badge text-bg-<%= row._id === 'Lost' ? 'danger' : 'success' %>"><%= row._id %></span></td>
              <td class="text-end"><%= row.total %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>

</main>

<%- include('partials/footer') %>
