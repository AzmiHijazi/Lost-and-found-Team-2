<%- include('partials/header', { title, currentPage: 'contact' }) %>

<main id="main-content">
  <section class="bg-white border-bottom py-5">
    <div class="container text-center">
      <p class="text-uppercase small fw-semibold text-primary mb-2">We're here to help</p>
      <h1 class="fw-bold mb-3">Let&rsquo;s find a way forward.</h1>
      <p class="lead text-secondary mb-0 mx-auto">Have a question about a lost item, a found item, or your account? Send us a message and our support team will help point you in the right direction.</p>
    </div>
  </section>

  <section class="container py-5" aria-labelledby="contact-form-heading">
    <div class="row g-4">
      <aside class="col-lg-5" aria-labelledby="contact-details-heading">
        <p class="text-uppercase small fw-semibold text-primary mb-2">Get in touch</p>
        <h2 id="contact-details-heading" class="h3 fw-bold">A little help goes a long way.</h2>
        <p class="text-secondary">Use the form to send your question. Please include any useful item details, such as its category, color, and where it was last seen.</p>

        <div class="d-flex flex-column gap-3 mt-4">
          <div class="card border-0 shadow-sm">
            <div class="card-body d-flex gap-3">
              <span class="fs-4 text-warning" aria-hidden="true">&#10022;</span>
              <div>
                <h3 class="h6 fw-semibold mb-1">Helpful details</h3>
                <p class="mb-0 text-secondary small">Item description, location, and date make it easier for us to assist.</p>
              </div>
            </div>
          </div>
          <div class="card border-0 shadow-sm">
            <div class="card-body d-flex gap-3">
              <span class="fs-4 text-warning" aria-hidden="true">&#8599;</span>
              <div>
                <h3 class="h6 fw-semibold mb-1">Quick response</h3>
                <p class="mb-0 text-secondary small">We aim to reply to support requests within one business day.</p>
              </div>
            </div>
          </div>
        </div>
      </aside>

      <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
          <div class="card-body p-4 p-md-5">
            <p class="text-uppercase small fw-semibold text-primary mb-2">Contact form</p>
            <h2 id="contact-form-heading" class="h3 fw-bold">How can we help?</h2>
            <p class="text-secondary">Fields marked with <span aria-hidden="true">*</span> are required.</p>

            <% if (sent) { %>
              <div class="alert alert-success" role="status">
                <strong>Thanks for reaching out.</strong>
                <span>Your message has been submitted successfully.</span>
              </div>
            <% } %>

            <% if (Object.keys(errors).length > 0) { %>
              <div class="alert alert-danger" role="alert">
                <strong>Please review the highlighted fields.</strong>
                <span>We need a few more details before your message can be submitted.</span>
              </div>
            <% } %>

            <form action="/contact" method="post" novalidate>
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label" for="name">Your name <span aria-hidden="true">*</span></label>
                  <input class="form-control <%= errors.name ? 'is-invalid' : '' %>" id="name" name="name" type="text" autocomplete="name" maxlength="80" value="<%= form.name %>" <%= errors.name ? 'aria-describedby="name-error"' : '' %> aria-invalid="<%= errors.name ? 'true' : 'false' %>" required>
                  <% if (errors.name) { %><div class="invalid-feedback" id="name-error"><%= errors.name %></div><% } %>
                </div>

                <div class="col-md-6">
                  <label class="form-label" for="email">Email address <span aria-hidden="true">*</span></label>
                  <input class="form-control <%= errors.email ? 'is-invalid' : '' %>" id="email" name="email" type="email" autocomplete="email" maxlength="120" value="<%= form.email %>" <%= errors.email ? 'aria-describedby="email-error"' : '' %> aria-invalid="<%= errors.email ? 'true' : 'false' %>" required>
                  <% if (errors.email) { %><div class="invalid-feedback" id="email-error"><%= errors.email %></div><% } %>
                </div>
              </div>

              <div class="mt-3">
                <label class="form-label" for="subject">What do you need help with? <span aria-hidden="true">*</span></label>
                <select class="form-select <%= errors.subject ? 'is-invalid' : '' %>" id="subject" name="subject" <%= errors.subject ? 'aria-describedby="subject-error"' : '' %> aria-invalid="<%= errors.subject ? 'true' : 'false' %>" required>
                  <option value="" <%= !form.subject ? 'selected' : '' %> disabled>Select a topic</option>
                  <option value="Lost item" <%= form.subject === 'Lost item' ? 'selected' : '' %>>I lost an item</option>
                  <option value="Found item" <%= form.subject === 'Found item' ? 'selected' : '' %>>I found an item</option>
                  <option value="Account support" <%= form.subject === 'Account support' ? 'selected' : '' %>>Account support</option>
                  <option value="Other" <%= form.subject === 'Other' ? 'selected' : '' %>>Something else</option>
                </select>
                <% if (errors.subject) { %><div class="invalid-feedback" id="subject-error"><%= errors.subject %></div><% } %>
              </div>

              <div class="mt-3">
                <label class="form-label" for="message">Your message <span aria-hidden="true">*</span></label>
                <textarea class="form-control <%= errors.message ? 'is-invalid' : '' %>" id="message" name="message" rows="6" maxlength="1500" aria-describedby="<%= errors.message ? 'message-help message-error' : 'message-help' %>" aria-invalid="<%= errors.message ? 'true' : 'false' %>" required><%= form.message %></textarea>
                <% if (errors.message) { %><div class="invalid-feedback" id="message-error"><%= errors.message %></div><% } %>
                <div class="form-text" id="message-help">Please do not include passwords or other sensitive information.</div>
              </div>

              <button class="btn btn-primary mt-4" type="submit">Send message <span aria-hidden="true">&rarr;</span></button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer', { year }) %>
