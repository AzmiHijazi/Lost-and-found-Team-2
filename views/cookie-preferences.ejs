<%- include('partials/header', { title: title, currentPage: currentPage }) %>

    <main id="main-content" class="flex-grow-1">

        <div class="container py-5">

            <div class="row justify-content-center">

                <div class="col-md-8 col-lg-6">

                    <div class="card shadow-sm">

                        <div class="card-body p-4">

                            <h1 class="h3 mb-3">
                                Cookie Preferences
                            </h1>

                            <p class="text-secondary">
                                Choose how the Lost &amp; Found System should save your preferences.
                            </p>

                            <div class="alert alert-info">

                                Current preference:

                                <strong>
                                    <%= preference==='accepted' ? 'Allow Preferences' : 'Essential Only' %>
                                </strong>

                            </div>

                            <form action="/cookie-preferences" method="POST">

                                <div class="form-check mb-3">

                                    <input class="form-check-input" type="radio" name="preference" id="accepted"
                                        value="accepted" <%=preference==='accepted' ? 'checked' : '' %>
                                    >

                                    <label class="form-check-label" for="accepted">
                                        Allow Preferences
                                    </label>

                                </div>

                                <div class="form-check mb-4">

                                    <input class="form-check-input" type="radio" name="preference" id="essential"
                                        value="essential" <%=preference==='essential' ? 'checked' : '' %>
                                    >

                                    <label class="form-check-label" for="essential">
                                        Essential Only
                                    </label>

                                </div>

                                <button type="submit" class="btn btn-primary">
                                    Save Preferences
                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </main>

    <%- include('partials/footer') %>