<!-- Item Details Page (:id route) — owner: Omar -->
<!-- TEMP: this page is self-contained for now. When the team partials merge,
     replace everything from <!DOCTYPE> down to <body> with
     <%%- include('./partials/header') %> + <%%- include('./partials/nav') %>,
     and the closing tags with <%%- include('./partials/footer') %>. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Lost & Found</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<main class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h1 class="h4 mb-0"><%= item.name %></h1>
          <% if (item.status === 'Lost') { %>
            <span class="badge bg-danger">Lost</span>
          <% } else { %>
            <span class="badge bg-success">Found</span>
          <% } %>
        </div>
        <div class="card-body">
          <p class="mb-2"><strong>Category:</strong> <%= item.category %></p>
          <p class="mb-2"><strong>Location:</strong> <%= item.location %></p>
          <p class="mb-2"><strong>Date:</strong> <%= item.date %></p>
          <p class="mb-2"><strong>Description:</strong> <%= item.description %></p>
          <p class="mb-0"><strong>Contact:</strong> <a href="mailto:<%= item.contactEmail %>"><%= item.contactEmail %></a></p>
        </div>
        <div class="card-footer">
          <a href="/items" class="btn btn-secondary">&larr; Back to Items</a>
        </div>
      </div>
    </div>
  </div>
</main>
<!-- Bootstrap JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
