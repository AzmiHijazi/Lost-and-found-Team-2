<% const activePage=typeof currentPage==='string' ? currentPage : '' ; const currentUser=typeof user !=='undefined' ?
  user : null; %>


  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm" aria-label="Main navigation">

    <div class="container">

      <a class="navbar-brand fw-semibold" href="/">
        Lost &amp; Found
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
        aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainNavigation">

        <ul class="navbar-nav ms-auto">

          <li class="nav-item">
            <a class="nav-link <%= activePage === 'home' ? 'active' : '' %>" href="/">Home</a>
          </li>

          <li class="nav-item">
            <a class="nav-link <%= activePage === 'items' ? 'active' : '' %>" href="/items">Items</a>
          </li>

          <li class="nav-item">
            <a class="nav-link <%= activePage === 'search' ? 'active' : '' %>" href="/search">Search</a>
          </li>

          <li class="nav-item">
            <a class="nav-link <%= activePage === 'about' ? 'active' : '' %>" href="/about">About</a>
          </li>

          <li class="nav-item">
            <a class="nav-link <%= activePage === 'contact' ? 'active' : '' %>" href="/contact">Contact</a>
          </li>

          <li class="nav-item">
            <a class="nav-link <%= activePage === 'preferences' ? 'active' : '' %>"
              href="/cookie-preferences">Preferences</a>
          </li>

          <% if (currentUser) { %>

            <li class="nav-item">
              <a class="nav-link <%= activePage === 'dashboard' ? 'active' : '' %>" href="/dashboard">Dashboard</a>
            </li>

            <li class="nav-item">
              <a class="nav-link <%= activePage === 'report' ? 'active' : '' %>" href="/report-item">Report Item</a>
            </li>

            <li class="nav-item">
              <a class="nav-link <%= activePage === 'submissions' ? 'active' : '' %>" href="/my-submissions">My
                Submissions</a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/logout">Logout</a>
            </li>

            <% } else { %>

              <li class="nav-item">
                <a class="nav-link <%= activePage === 'register' ? 'active' : '' %>" href="/register">Register</a>
              </li>

              <li class="nav-item">
                <a class="nav-link <%= activePage === 'login' ? 'active' : '' %>" href="/login">Login</a>
              </li>

              <% } %>

        </ul>

      </div>

    </div>

  </nav>