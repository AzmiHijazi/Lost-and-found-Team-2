<% const activePage = typeof currentPage === 'string' ? currentPage : ''; %>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm" aria-label="Main navigation">
  <div class="container">
    <a class="navbar-brand fw-semibold" href="/">Lost &amp; Found</a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#mainNavigation"
      aria-controls="mainNavigation"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNavigation">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <a class="nav-link <%= activePage === 'home' ? 'active' : '' %>" href="/" <% if (activePage === 'home') { %>aria-current="page"<% } %>>Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= activePage === 'items' ? 'active' : '' %>" href="/items" <% if (activePage === 'items') { %>aria-current="page"<% } %>>Items</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= activePage === 'about' ? 'active' : '' %>" href="/about" <% if (activePage === 'about') { %>aria-current="page"<% } %>>About</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= activePage === 'contact' ? 'active' : '' %>" href="/contact" <% if (activePage === 'contact') { %>aria-current="page"<% } %>>Contact</a>
        </li>
      </ul>
    </div>
  </div>
</nav>
