<%- include('partials/header', { title, currentPage: 'home' }) %>

<main id="main-content">
    <section class="bg-white border-bottom py-5">
        <div class="container text-center">

            <h1 class="fw-bold mb-3">Lost and Found System</h1>

            <p class="lead text-secondary mb-0 mx-auto" style="max-width: 42rem;">
                Welcome to the Lost and Found System.
                This website helps students report lost items
                and search for found items on campus.
            </p>

            <div class="d-flex flex-column flex-sm-row justify-content-center gap-2 mt-4">

                <a href="/items" class="btn btn-primary">
                    Browse Items <span aria-hidden="true">&rarr;</span>
                </a>

                <a href="/contact" class="btn btn-outline-primary">
                    Report an Item
                </a>

            </div>

        </div>
    </section>
</main>

<%- include('partials/footer', { year }) %>
