<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Lost and Found System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include("partials/header") %>

    <div class="container mt-5 text-center">

        <h1>Lost and Found System</h1>

        <p class="mt-3">
            Welcome to the Lost and Found System.
            This website helps students report lost items
            and search for found items on campus.
        </p>

        <div class="mt-4">

            <a href="/report-item" class="btn btn-primary me-2">
                Report an Item
            </a>

            <a href="/lost-items" class="btn btn-outline-dark">
                View Lost Items
            </a>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>